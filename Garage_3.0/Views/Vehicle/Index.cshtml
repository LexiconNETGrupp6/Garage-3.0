@model IEnumerable<Garage_3._0.Models.Vehicle>

@{
    ViewData["Title"] = "Index";
}

<h1>List of Vehicle(s)</h1>

<p>
    <a asp-action="Create">Register New Vehicle</a>
</p>

<div class="d-flex flex-row column-gap-1">
    <p>Parking spots available:</p>
    <p>@ViewData["ParkingSpotsAvailable"]</p>
    <p>/</p>
    <p>@ViewData["ParkingSpotsTotal"]</p>
</div>

<form asp-action="Index" method="get" class="mb-3">
    <div class="input-group">
        <input type="text" name="search" value="@ViewData["CurrentFilter"]" class="form-control"
               placeholder="Search by license, type, model, color..." />
        <button type="submit" class="btn btn-primary">Search</button>
        <a asp-action="Index" class="btn btn-secondary">Clear</a>
    </div>
</form>
<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead class="table-dark">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.LicenseNumber)
            </th>
            <th>
                Parking Spot(s):
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NumberOfWheels)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ArrivalTime)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Owner)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.VehicleType)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.LicenseNumber)
            </td>
            <td>
                        @if (item.Parkings is not null)
                        {
                            @foreach (Parking parking in item.Parkings)
                            {
                                <span>@parking.ParkingSpotId </span>
                            }
                        }
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NumberOfWheels)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ArrivalTime)
            </td>
            <td>
                    @Html.DisplayFor(modelItem => item.Owner.Email)
            </td>
            <td>
                    @Html.DisplayFor(modelItem => item.VehicleType.Name)
            </td>
            <td>
                @if (!item.Parkings.Any(p => p.IsActive))
                {
                    <a asp-action="ParkVehicle" asp-route-id="@item.Id">Park Vehicle</a>
                    <span> |</span>
                        }
                        <a asp-action="Edit" asp-route-id="@item.Id"><i class="bi bi-eye"></i>Edit</a> |
                        <a asp-action="Details" asp-route-id="@item.Id"><i class="bi bi-eye"></i>Details</a> |
                        <a asp-action="Delete" asp-route-id="@item.Id"><i class="bi btn-outline-info"></i>Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>