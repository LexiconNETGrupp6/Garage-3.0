@model Garage_3._0.Models.ParkingSpot

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <h4>ParkingSpot</h4>
    <hr />
    <dl class="row">
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.SpotNumber)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.SpotNumber)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.Size)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.Size)
        </dd>
        <dt class = "col-sm-2">
            @Html.DisplayNameFor(model => model.IsTaken)
        </dt>
        <dd class = "col-sm-10">
            @Html.DisplayFor(model => model.IsTaken)
        </dd>
    </dl>
    
    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />

        @if (Model.IsTaken)
        {
            <div class="alert alert-warning">
                Space taken cannot be deleted.
            </div>

            <input type="submit" value="Delete" class="btn btn-danger" disabled="disabled" />
        }
        else
        {
            <input type="submit" value="Delete" class="btn btn-danger" />
        }

        |
        <a asp-action="Index">Back to List</a>
    </form>
</div>
