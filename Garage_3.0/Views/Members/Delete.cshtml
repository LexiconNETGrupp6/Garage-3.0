@model Garage_3._0.Models.ViewModels.MemberViewModel

@{
    ViewData["Title"] = "Delete Member";
}

<div>

<h2 class="text-danger">Delete Member</h2>
<hr />

<div class="alert alert-warning">
    ⚠️ Are you sure you want to delete this member?
</div>

<dl class="row">
    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.User.FirstName @Model.User.LastName</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.User.Email</dd>
</dl>

    <form asp-action="Delete" method="post">
    <input type="hidden" name="id" value="@Model.Id" />

    <button type="submit" class="btn btn-danger">
        <i class="bi bi-trash"></i> Confirm Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>
</form>

</div>
