@model Garage_3._0.Models.ViewModels.MemberViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>MemberViewModel</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="VehicleCount" class="control-label"></label>
                <input asp-for="VehicleCount" class="form-control" />
                <span asp-validation-for="VehicleCount" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ActiveParkingCount" class="control-label"></label>
                <input asp-for="ActiveParkingCount" class="form-control" />
                <span asp-validation-for="ActiveParkingCount" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TotalCurrentCost" class="control-label"></label>
                <input asp-for="TotalCurrentCost" class="form-control" />
                <span asp-validation-for="TotalCurrentCost" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="IsProMember" /> @Html.DisplayNameFor(model => model.IsProMember)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="Roles" class="control-label"></label>
                <input asp-for="Roles" class="form-control" />
                <span asp-validation-for="Roles" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
